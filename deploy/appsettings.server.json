// Server-wide overrides for a systemd deployment. deploy/deploy.sh installs this as
// /etc/worldbox-multiplayer/appsettings.json on the FIRST run only (later deploys never
// touch it). Every key you leave out keeps its default from the shipped appsettings.json.
// This file holds your secrets once filled in: it is root:wbmp, mode 640, never committed.
{
  "Port": 40441,

  "Database": {
    "Provider": "sqlite",
    "ConnectionString": "Data Source=/var/lib/worldbox-multiplayer/worldbox-multiplayer.db"
  },

  "Admin": {
    "Enabled": false,
    "Bind": "127.0.0.1",
    "Port": 40480,
    "User": "admin",
    "Password": ""
  }
}

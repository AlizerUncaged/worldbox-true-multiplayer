# WorldBox Multiplayer server settings. Copy to .env next to the server binary or in the
# directory you run it from (local), or to /etc/worldbox-multiplayer.env (deploy/deploy.sh
# installs it there on the first run). Real environment variables override this file;
# both override appsettings.json. Never commit a filled-in .env.
WBMP_PORT=50001
WBMP_DATABASE_BRAND=sqlite
WBMP_CONNECTION_STRING=Data Source=/var/lib/worldbox-multiplayer/worldbox-multiplayer.db
# Advertised at /api/v1/version for the in-game update notice (optional).
WBMP_LATEST_VERSION=
WBMP_MIN_VERSION=

# Server lobbies (always open, ids 0000, 0001, ...) and room limits.
#WBMP_LOBBIES=Lobby;Sandbox;Chaos
#WBMP_MAX_PLAYERS=16
#WBMP_MAX_ROOMS=200

# Admin website (off unless enabled). The password seeds the first admin on first start;
# change it later from the site. Set WBMP_ADMIN_PASSWORD_RESET=true to force it again.
WBMP_ADMIN_ENABLED=false
WBMP_ADMIN_BIND=127.0.0.1
WBMP_ADMIN_PORT=50002
WBMP_ADMIN_USER=admin
WBMP_ADMIN_PASSWORD=
#WBMP_ADMIN_PASSWORD_RESET=false

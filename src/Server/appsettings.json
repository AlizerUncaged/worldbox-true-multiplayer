// WorldBox Multiplayer server settings (defaults). Do NOT put secrets in this file.
//
// Override any value without editing it:
//   - appsettings.Local.json next to the server or in the working directory (git-ignored),
//     containing only the keys you change;
//   - a file named by the WBMP_SETTINGS environment variable (deploy/deploy.sh uses
//     /etc/worldbox-multiplayer/appsettings.json);
//   - environment variables: WBMP_ prefix, "__" for nesting, e.g. WBMP_Port=50001,
//     WBMP_Admin__Enabled=true, WBMP_Admin__Password=...
{
  // Shared port number: UDP for the game, TCP for the REST api (/api/v1/version, /health).
  "Port": 40441,

  // Advertised to clients for the in-game update notice (empty = no notice).
  "LatestVersion": "",
  "MinimumVersion": "",

  "Database": {
    // "sqlite" (zero setup, one file) or "mongodb".
    "Provider": "sqlite",
    "ConnectionString": "Data Source=worldbox-multiplayer-local.db"
  },

  "Rooms": {
    // Always-open server lobbies, in order: ids 0000, 0001, ...
    "Lobbies": [ "Lobby", "Sandbox", "Chaos" ],
    // Player cap per room (0 = no cap) and cap on player-made rooms (0 = no cap).
    "MaxPlayersPerRoom": 16,
    "MaxRooms": 200
  },

  "Admin": {
    // Web admin panel (players, rooms, bans, announcements). Off by default.
    "Enabled": false,
    // 127.0.0.1 = this machine only (use an SSH tunnel). 0.0.0.0 exposes it: use HTTPS then.
    "Bind": "127.0.0.1",
    "Port": 40480,
    "User": "admin",
    // Seeds the first admin on first start (8+ characters). Set it in appsettings.Local.json
    // or WBMP_Admin__Password, never here. Change it later from the panel.
    "Password": "",
    // true = overwrite the stored admin password with Password on the next start.
    "ResetPassword": false
  },

  "Https": {
    // PFX certificate for the REST api and the admin panel. Empty = plain HTTP.
    "CertificatePath": "",
    "CertificatePassword": ""
  }
}

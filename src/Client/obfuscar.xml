<?xml version="1.0" encoding="utf-8"?>
<!-- Obfuscar config for the SHIPPED client DLL (Release post-build; see the
     ObfuscateAndPublish target in WorldboxMP.Client.csproj). Paths are relative to
     the working directory the tool runs in: src/Client/bin/Release.

     What must NOT be renamed (name-based runtime lookups; renaming = silent death):
       - Public API surface (KeepPublicApi): NML finds ModMain by reflection, modders
         compile against WbmpApi, and public members are our stable surface.
       - GameHooks: every Harmony patch method is resolved by STRING name (nameof).
       - Unity message methods (Awake/Update/OnApplicationQuit...): the engine invokes
         them by name; they are private, so HidePrivateApi would rename them.
       - Siccity.GLTFUtility: third-party importer whose spec classes are deserialized
         from glb JSON by PROPERTY NAME (Newtonsoft); renaming breaks model loading.
     Everything else private/internal is renamed, and IL strings are hidden. -->
<Obfuscator>
  <Var name="InPath" value="." />
  <Var name="OutPath" value=".\obfuscated" />

  <Var name="KeepPublicApi" value="true" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="HideStrings" value="true" />
  <Var name="RenameFields" value="true" />
  <Var name="RenameProperties" value="true" />
  <Var name="RenameEvents" value="true" />
  <Var name="UseUnicodeNames" value="true" />
  <Var name="ReuseNames" value="true" />
  <Var name="SuppressIldasm" value="true" />

  <!-- Resolve references: game + modloader + harmony assemblies. -->
  <AssemblySearchPath path="..\..\..\..\..\..\worldbox_Data\Managed" />
  <AssemblySearchPath path="..\..\..\..\..\..\worldbox_Data\StreamingAssets\mods" />
  <AssemblySearchPath path="..\..\..\..\..\..\worldbox_Data\StreamingAssets\mods\NML" />
  <AssemblySearchPath path="..\..\..\..\..\..\worldbox_Data\StreamingAssets\mods\NML\Assemblies" />

  <Module file="$(InPath)\WorldboxMP.Client.dll">
    <!-- The license/AI notice must stay readable VERBATIM in any decompiler output
         (that is its entire purpose) - never rename or touch it. -->
    <SkipType name="WorldboxMP.Client.LicenseNotice" skipMethods="true" skipFields="true" skipProperties="true" skipEvents="true" skipStringHiding="true" />

    <!-- Harmony patches are looked up by method-name strings. -->
    <SkipType name="WorldboxMP.Client.Mirror.GameHooks" skipMethods="true" skipFields="true" skipProperties="true" skipEvents="true" />

    <!-- Third-party glTF importer: JSON-mapped spec classes + its own reflection. -->
    <SkipNamespace name="Siccity.GLTFUtility" />
    <SkipNamespace name="Siccity.GLTFUtility.Converters" />

    <!-- Unity engine messages, invoked by name on private methods. -->
    <SkipMethod type="WorldboxMP.Client.NetPump" name="Update" />
    <SkipMethod type="WorldboxMP.Client.NetPump" name="OnApplicationQuit" />
    <SkipMethod type="WorldboxMP.Client.UI.Model3D" name="Update" />
    <SkipMethod type="WorldboxMP.Client.UI.PingHud" name="Awake" />
    <SkipMethod type="WorldboxMP.Client.UI.PingHud" name="Update" />
    <SkipMethod type="WorldboxMP.Client.UI.PlayerCursors" name="Awake" />
    <SkipMethod type="WorldboxMP.Client.UI.PlayerCursors" name="Update" />
  </Module>
</Obfuscator>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WorldboxMP.Client</AssemblyName>
    <RootNamespace>WorldboxMP.Client</RootNamespace>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Copy NuGet deps (LiteNetLib) + the Shared dll into output for deployment. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Release channel, single-sourced: baked into the assembly as metadata (read by
         ModInfo for the HUD version badge) AND used in the bin\Publish folder name.
         Flip to "release" (or clear) when we leave beta. -->
    <ReleaseChannel>beta</ReleaseChannel>

    <!-- WorldBox install root. Set the WORLDBOX_DIR env var (or -p:GameDir=...) when the
         repo lives elsewhere; otherwise Projects/Worldbox-Multiplayer/src/Client -> up 4. -->
    <GameDir Condition="'$(GameDir)' == '' and '$(WORLDBOX_DIR)' != ''">$(WORLDBOX_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProjectDirectory)\..\..\..\..</GameDir>
    <ManagedDir>$(GameDir)\worldbox_Data\Managed</ManagedDir>
    <ModsDir>$(GameDir)\worldbox_Data\StreamingAssets\mods</ModsDir>
    <!-- Live mod folder NML scans. Debug builds auto-deploy the whole output here. -->
    <DeployDir>$(GameDir)\Mods\WorldBoxMultiplayer</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="mscorlib" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ReleaseChannel" Value="$(ReleaseChannel)" />
  </ItemGroup>

  <!-- Game / modloader assemblies (compile-only; not copied) -->
  <ItemGroup>
    <Reference Include="NeoModLoader">
      <HintPath>$(ModsDir)\NeoModLoader.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ModsDir)\NML\Assemblies\0Harmony.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ModsDir)\NML\Assembly-CSharp-Publicized.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private>
    </Reference>
    <!-- 3D model rendering (GLTFUtility): AnimationClip, meshes, etc. -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestTextureModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestTextureModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(ManagedDir)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Networking + shared protocol (these DO get copied to output for deployment) -->
  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.1" />
    <ProjectReference Include="..\Shared\WorldboxMP.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="mod.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- NML mod-list icon (mod.json "iconPath"), drawn at 48x48 in the mods window. -->
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('icon.png')" />
  </ItemGroup>

  <!-- Icons baked into the dll so the mod is self-contained. Explicit LogicalName
       so we can fetch them by a stable name regardless of MSBuild mangling. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\multiplayer-header-icon.png">
      <LogicalName>multiplayer-header-icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\player-list-icon.png">
      <LogicalName>player-list-icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\login-icon.png">
      <LogicalName>login-icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\title-banner.png">
      <LogicalName>title-banner.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\logs-icon.png">
      <LogicalName>logs-icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\settings-icon.png">
      <LogicalName>settings-icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\create-room-icon.png">
      <LogicalName>create-room-icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\join-room-icon.png">
      <LogicalName>join-room-icon.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Date-based version, stamped on EVERY build into the DEPLOYED mod.json (the
       committed source keeps a placeholder). NML reads the deployed file, so the
       in-game badge shows e.g. beta-2026.07.30.2043 automatically. -->
  <PropertyGroup>
    <ModVersion>$([System.DateTime]::Now.ToString("yyyy.MM.dd.HHmm"))</ModVersion>
  </PropertyGroup>

  <!-- The official server origin, baked into the DLL as a constant (BuildConfig.g.cs in obj/).
       Forks override it without editing this file:
         dotnet build -p:MainServerSource=https://my.server:40441
       or put <MainServerSource> in a git-ignored WorldboxMP.Client.csproj.user next to this file.
       Scheme picks the shared TCP+UDP port (https=443, http=80); an explicit :port wins. -->
  <PropertyGroup>
    <MainServerSource Condition="'$(MainServerSource)' == ''">http://65.75.203.165:50001</MainServerSource>
  </PropertyGroup>
  <Target Name="GenerateBuildConfig" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_BuildConfigLines Include="// &lt;auto-generated&gt; From the MainServerSource MSBuild property. Do not edit. &lt;/auto-generated&gt;" />
      <_BuildConfigLines Include="namespace WorldboxMP.Client { public static class BuildConfig {" />
      <_BuildConfigLines Include="    /// &lt;summary&gt;The official server origin baked at build time.&lt;/summary&gt;" />
      <_BuildConfigLines Include="    public const string MainServerSource = &quot;$(MainServerSource)&quot;%3B" />
      <_BuildConfigLines Include="} }" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildConfig.g.cs" Lines="@(_BuildConfigLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildConfig.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Debug auto-deploy: copy the WHOLE client output (Client + Shared + LiteNetLib +
       mod.json) into the live Mods folder so deploys never go out of sync. -->
  <Target Name="DeployToMods" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <!-- Only the mod DLL at the top level (NeoModLoader treats every top-level DLL as a mod);
           dependencies go to lib/ and are resolved by LibResolver. -->
      <_DeployFiles Include="$(OutDir)WorldboxMP.Client.dll" />
      <_DeployLibs Include="$(OutDir)LiteNetLib.dll;$(OutDir)WorldboxMP.Shared.dll" />
      <_StaleRootLibs Include="$(DeployDir)\LiteNetLib.dll;$(DeployDir)\WorldboxMP.Shared.dll" />
      <_DeployFiles Include="$(OutDir)mod.json" Condition="Exists('$(OutDir)mod.json')" />
      <_DeployFiles Include="$(OutDir)icon.png" Condition="Exists('$(OutDir)icon.png')" />
      <!-- 3D easter-egg models loaded at runtime from the mod folder. -->
      <_DeployGlb Include="$(MSBuildProjectDirectory)\Assets3D\*.glb" />
    </ItemGroup>
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="@(_DeployFiles)" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_DeployLibs)" DestinationFolder="$(DeployDir)\lib" SkipUnchangedFiles="false" />
    <Delete Files="@(_StaleRootLibs)" ContinueOnError="true" />
    <Copy SourceFiles="@(_DeployGlb)" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="true" />
    <!-- Script file, not python -c: inline commands pass through cmd.exe, which eats
         the ^ in the regex and silently leaves the placeholder version in place. -->
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\stamp_version.py&quot; &quot;$(DeployDir)\mod.json&quot; $(ModVersion)" />
    <Message Importance="high" Text="[WBMP] Deployed client -> $(DeployDir) (version $(ModVersion))" />
  </Target>

  <!-- Release ship pipeline: obfuscate the client DLL (Obfuscar, config in
       obfuscar.xml - it protects every name-based runtime lookup) and assemble a
       ready-to-ship mod folder in bin\Publish: obfuscated client + Shared +
       LiteNetLib + mod.json + runtime assets. Mapping.txt (rename map for
       debugging user crash reports) stays in bin\Release\obfuscated. -->
  <Target Name="ObfuscateAndPublish" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <!-- Each ship build lands in a folder named after its full version:
           bin\Publish\beta-2026.07.30.2043 - the same string players see in the HUD. -->
      <PublishModDir>$(MSBuildProjectDirectory)\bin\Publish\$(ReleaseChannel)-$(ModVersion)</PublishModDir>
    </PropertyGroup>
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)\..\.." EnvironmentVariables="DOTNET_CLI_TELEMETRY_OPTOUT=1;DOTNET_NOLOGO=1" />
    <PropertyGroup>
      <_ObfGameDir>$([System.IO.Path]::GetFullPath('$(GameDir)'))</_ObfGameDir>
      <_ObfXml>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\obfuscar.xml').Replace('{GAMEDIR}', '$(_ObfGameDir)'))</_ObfXml>
    </PropertyGroup>
    <WriteLinesToFile File="$(TargetDir)obfuscar.generated.xml" Lines="$([MSBuild]::Escape('$(_ObfXml)'))" Overwrite="true" />
    <Exec Command="dotnet tool run obfuscar.console &quot;$(TargetDir)obfuscar.generated.xml&quot;" WorkingDirectory="$(TargetDir)" EnvironmentVariables="DOTNET_CLI_TELEMETRY_OPTOUT=1;DOTNET_NOLOGO=1" />
    <ItemGroup>
      <_ShipDlls Include="$(TargetDir)obfuscated\WorldboxMP.Client.dll" />
      <_ShipLibs Include="$(TargetDir)WorldboxMP.Shared.dll;$(TargetDir)LiteNetLib.dll" />
      <_ShipFiles Include="$(OutDir)mod.json" Condition="Exists('$(OutDir)mod.json')" />
      <_ShipFiles Include="$(OutDir)icon.png" Condition="Exists('$(OutDir)icon.png')" />
      <_ShipGlb Include="$(MSBuildProjectDirectory)\Assets3D\*.glb" />
    </ItemGroup>
    <MakeDir Directories="$(PublishModDir)" />
    <Copy SourceFiles="@(_ShipDlls)" DestinationFolder="$(PublishModDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_ShipLibs)" DestinationFolder="$(PublishModDir)\lib" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_ShipFiles)" DestinationFolder="$(PublishModDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_ShipGlb)" DestinationFolder="$(PublishModDir)" SkipUnchangedFiles="true" />
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\stamp_version.py&quot; &quot;$(PublishModDir)\mod.json&quot; $(ModVersion)" />
    <Message Importance="high" Text="[WBMP] Obfuscated ship build $(ReleaseChannel)-$(ModVersion) -> $(PublishModDir)" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WorldboxMP.Client</AssemblyName>
    <RootNamespace>WorldboxMP.Client</RootNamespace>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Copy NuGet deps (LiteNetLib) + the Shared dll into output for deployment. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- WorldBox install root: Projects/Worldbox-Multiplayer/src/Client -> up 4. -->
    <GameDir>$(MSBuildProjectDirectory)\..\..\..\..</GameDir>
    <ManagedDir>$(GameDir)\worldbox_Data\Managed</ManagedDir>
    <ModsDir>$(GameDir)\worldbox_Data\StreamingAssets\mods</ModsDir>
    <!-- Live mod folder NML scans. Debug builds auto-deploy the whole output here. -->
    <DeployDir>$(GameDir)\Mods\WorldBoxMultiplayer</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="mscorlib" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <!-- Game / modloader assemblies (compile-only; not copied) -->
  <ItemGroup>
    <Reference Include="NeoModLoader">
      <HintPath>$(ModsDir)\NeoModLoader.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ModsDir)\NML\Assemblies\0Harmony.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ModsDir)\NML\Assembly-CSharp-Publicized.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private>
    </Reference>
    <!-- 3D model rendering (GLTFUtility): AnimationClip, meshes, etc. -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestTextureModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestTextureModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Networking + shared protocol (these DO get copied to output for deployment) -->
  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.1" />
    <ProjectReference Include="..\Shared\WorldboxMP.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Icons baked into the dll so the mod is self-contained. Explicit LogicalName
       so we can fetch them by a stable name regardless of MSBuild mangling. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\multiplayer-header-icon.png">
      <LogicalName>multiplayer-header-icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\player-list-icon.png">
      <LogicalName>player-list-icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\login-icon.png">
      <LogicalName>login-icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\title-banner.png">
      <LogicalName>title-banner.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\logs-icon.png">
      <LogicalName>logs-icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\settings-icon.png">
      <LogicalName>settings-icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\create-room-icon.png">
      <LogicalName>create-room-icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\join-room-icon.png">
      <LogicalName>join-room-icon.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Debug auto-deploy: copy the WHOLE client output (Client + Shared + LiteNetLib +
       mod.json) into the live Mods folder so deploys never go out of sync. -->
  <Target Name="DeployToMods" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <_DeployFiles Include="$(OutDir)*.dll" />
      <_DeployFiles Include="$(OutDir)mod.json" Condition="Exists('$(OutDir)mod.json')" />
      <!-- 3D easter-egg models loaded at runtime from the mod folder. -->
      <_DeployGlb Include="$(MSBuildProjectDirectory)\Assets3D\*.glb" />
    </ItemGroup>
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="@(_DeployFiles)" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_DeployGlb)" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="[WBMP] Deployed client -> $(DeployDir)" />
  </Target>

  <!-- Release ship pipeline: obfuscate the client DLL (Obfuscar, config in
       obfuscar.xml - it protects every name-based runtime lookup) and assemble a
       ready-to-ship mod folder in bin\Publish: obfuscated client + Shared +
       LiteNetLib + mod.json + runtime assets. Mapping.txt (rename map for
       debugging user crash reports) stays in bin\Release\obfuscated. -->
  <Target Name="ObfuscateAndPublish" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <!-- Each ship build lands in its own dated folder: bin\Publish\YYYY-MM-DD-HHmmss -->
      <PublishStamp>$([System.DateTime]::Now.ToString("yyyy-MM-dd-HHmmss"))</PublishStamp>
      <PublishModDir>$(MSBuildProjectDirectory)\bin\Publish\$(PublishStamp)</PublishModDir>
    </PropertyGroup>
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)\..\.." />
    <Exec Command="dotnet tool run obfuscar.console &quot;$(MSBuildProjectDirectory)\obfuscar.xml&quot;" WorkingDirectory="$(TargetDir)" />
    <ItemGroup>
      <_ShipDlls Include="$(TargetDir)obfuscated\WorldboxMP.Client.dll" />
      <_ShipDlls Include="$(TargetDir)WorldboxMP.Shared.dll" />
      <_ShipDlls Include="$(TargetDir)LiteNetLib.dll" />
      <_ShipFiles Include="$(OutDir)mod.json" Condition="Exists('$(OutDir)mod.json')" />
      <_ShipGlb Include="$(MSBuildProjectDirectory)\Assets3D\*.glb" />
    </ItemGroup>
    <MakeDir Directories="$(PublishModDir)" />
    <Copy SourceFiles="@(_ShipDlls)" DestinationFolder="$(PublishModDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_ShipFiles)" DestinationFolder="$(PublishModDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_ShipGlb)" DestinationFolder="$(PublishModDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="[WBMP] Obfuscated ship build -> $(PublishModDir)" />
  </Target>

</Project>
